# ==============================================================================
# PROJECT NOVA — Environment Configuration Template
# Copy this file to .env or .env.local and populate the secrets.
# Do NOT commit .env files containing real keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Nebius AI Studio & NVIDIA Models (Required for AI Tutor & Quiz Engine)
# ------------------------------------------------------------------------------
# Obtain your API key from https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron model hosted on Nebius. List the ids your key can use with:
#   curl -s -H "Authorization: Bearer $NEBIUS_API_KEY" https://api.tokenfactory.nebius.com/v1/models
NOVA_TUTOR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NOVA_GENERATE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# ------------------------------------------------------------------------------
# 2. Pilot Authentication & Session Security (Optional for local dev)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=
# Long random secret string to sign HMAC-SHA256 session cookies (e.g. openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_random_32_byte_secret_string

# Set to 1 to enable local mock logins at POST /api/auth/dev
NOVA_DEV_LOGIN=1

# ------------------------------------------------------------------------------
# 3. Cloud Storage / Upstash Redis (Required on Vercel; local fallback to .data/)
# ------------------------------------------------------------------------------
# Upstash Redis REST credentials for accounts, progress sync, and leaderboard
# Postgres (Neon) for accounts; used before Redis when set. Move existing accounts with: cd backend && python -m migrate_accounts
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatively, Vercel KV sets:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. Profile Picture & Doodle Storage
# ------------------------------------------------------------------------------
# Storage mode: 'local' (disk storage in uploads/avatars), 'redis_base64', or 's3'
AVATAR_STORAGE_MODE=local
# If using S3 / Cloudflare R2 / Nebius Object Storage:
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# ------------------------------------------------------------------------------
# 5. Frontend Environment Variables (Vite reads variables prefixed with VITE_)
# ------------------------------------------------------------------------------
# Toggle real Google Sign-in ('on' or 'off')
VITE_GOOGLE_AUTH=off
# The same Google Client ID for frontend Google Identity Services SDK
VITE_GOOGLE_CLIENT_ID=
# Backend base URL. Leave empty to use the same origin (the Vite dev proxy forwards /api to http://localhost:8000).
# Vite only reads frontend/.env* files, so set this in frontend/.env.local, not in the root .env.
VITE_COURSE_API=

# ------------------------------------------------------------------------------
# 6. Optional switches (all have sensible defaults)
# ------------------------------------------------------------------------------
# NOVA_RATE_LIMIT=off          turn off the per-visitor limits (handy while developing)
# NOVA_CACHE=off               write every course and topic again instead of reusing recent results
# NOVA_MODERATION=off          skip the check that refuses goals meant to cause serious harm
# NOVA_VERIFY_ANSWERS=off      skip the second opinion on graded quiz answers
# NOVA_VERIFY_DOCUMENTS=on     also check answers for courses written from documents (costs many more tokens)
# NOVA_JSON_SCHEMA=off         ask the model for plain JSON instead of schema-shaped JSON
# NOVA_THINKING=on             let the model reason before answering (slower, uses far more tokens)
# NOVA_DAILY_TOKEN_BUDGET=2000000   refuse new work once this many tokens were used today (set this in production)
# NOVA_ALERT_WEBHOOK=https://hooks.slack.com/...   gets a message when 80% of the budget is used, or when many model calls give up
# NOVA_FAILURE_ALERT=20    model calls that may give up in an hour before the alert (0 = off)
# PDF_MAX_TOTAL_PAGES=100      page limit for uploaded documents
# TRUST_PROXY_HEADERS=true     use X-Forwarded-For for rate limits (set when behind a proxy)
# KV_REST_API_URL / KV_REST_API_TOKEN   Upstash Redis, so limits, the cache and the usage ledger are shared between server instances
# NOVA_ALLOWED_MODELS=         extra model ids that may be used; by default only the Nano model is (a wrong setting is replaced by Nano)

# --- Seeing what the model costs (see docs/OBSERVABILITY.md) ---
# NOVA_ADMIN_TOKEN=            turns on /api/admin (and /admin), /api/admin/usage and /api/admin/metrics; they ask for this token
# NOVA_PRICE_INPUT_PER_M=0.06  price per million input tokens used for the cost estimate (confirm in the Nebius console)
# NOVA_PRICE_OUTPUT_PER_M=0.24 price per million output tokens
# LOG_FORMAT=json              one JSON object per log line, for log services
# NOVA_LOG_PROMPTS=on          save prompts and replies to backend/.data/prompts.jsonl (local debugging only, never on Vercel)

# ------------------------------------------------------------------------------
# Request records on /api/admin
# ------------------------------------------------------------------------------
# NOVA_TRACE_CONTENT=on    also keep prompts and replies in the recent-request records (7 days, your own store); they contain what learners typed; off by default
