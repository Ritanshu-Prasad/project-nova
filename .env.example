# ==============================================================================
# Project Nova — Environment Variables Template
# Copy this file to `.env` and populate with your local/production credentials.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# Runtime Environment (development | production)
ENVIRONMENT=development

# Session Signing Secret (Required in production: minimum 32 random characters)
# Generate via: openssl rand -hex 32
SESSION_SECRET=

# CORS Whitelist (Comma-separated list of trusted frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Upstream LLM Provider (Nebius AI Studio for hosted LLaMA-3.3-70B tutor)
NEBIUS_API_KEY=

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# Upstash Redis Storage (Required for production account & progress storage)
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...

# Developer Authentication Backdoor (ONLY for local offline testing, ignored in production)
NOVA_DEV_LOGIN=0
