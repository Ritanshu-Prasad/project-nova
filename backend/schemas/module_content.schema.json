{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "overview",
    "learning_objectives",
    "simple",
    "takeaways",
    "key_terms",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90
    },
    "overview": {
      "type": "string",
      "minLength": 40,
      "maxLength": 600
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "simple": {
      "type": "string",
      "minLength": 40,
      "maxLength": 600
    },
    "takeaways": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "key_terms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "explanation"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 3
          },
          "explanation": {
            "type": "string",
            "minLength": 120
          },
          "example": {
            "type": "string",
            "minLength": 20
          },
          "common_mistake": {
            "type": "string",
            "minLength": 20
          },
          "quick_check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 10
              },
              "answer": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "analogy": {
            "type": "string"
          },
          "action_steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "code": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "snippet",
              "explanation"
            ],
            "properties": {
              "language": {
                "type": "string"
              },
              "snippet": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    }
  }
}
